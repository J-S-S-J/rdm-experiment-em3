# Slopes of CSD (reponse locked)

```{r}
d1 <- read_csv("cpp_response_locked_data.csv") |> filter(Time > -0.5)
```



```{r}

# setup window
tmin_fit <- -0.25
tmax_fit <- -0.01


d1 |>
  ggplot(aes(x = Time, y = Amplitude)) +
  facet_wrap(~ Condition, labeller = as_labeller(c(
    "Control" = "Kontrol", 
    "BB" = "BB"
  ))) +
  
  # shade the window
  annotate("rect", xmin = tmin_fit, xmax = tmax_fit, ymin = -Inf, ymax = Inf, 
           fill = "gray", alpha = 0.2) +
  
  geom_vline(xintercept = 0, color = "black", linetype = "dashed") +
  geom_line(aes(group = Coherence, color = Coherence_Num), linewidth = 0.5, alpha = 0.5) +
  geom_smooth(
    data = d1 |> filter(Time >= tmin_fit & Time <= tmax_fit),
    aes(group = Coherence, color = Coherence_Num), 
    method = "lm",               
    formula = y ~ x,
    se = FALSE,               
    linewidth = 1) +
  
  
  scale_color_viridis_c(name = "Kohærens (%)", option = "viridis", direction = -1 ) +
  
  labs(
    title = "CPP Build-up rate per kohærens",
    x = "Tid (s)",
    y = expression("Amplitude")
  ) +
  theme_classic() +
  theme(
    legend.position = "right",
    plot.title = element_text(hjust = 0.5, face = "bold", size = 14),
    strip.text = element_text(face = "bold", size = 12),
    strip.background = element_blank()
  )


```


