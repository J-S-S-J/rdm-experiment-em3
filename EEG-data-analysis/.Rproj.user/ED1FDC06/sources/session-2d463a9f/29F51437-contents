# STINE 



```{r}
drift_rates <- tibble(
  Coherence = rep(c(0, 3, 6, 12, 25, 50), 2),
  Condition = c(rep("BB", 6), rep("Control", 6)),
  Drift_Rate = c(
    # Binaural Beats values
    0.599, 0.767, 0.934, 1.269, 1.996, 3.393,
    # Control values
    0.778, 0.945, 1.113, 1.448, 2.175, 3.572
  )
) |>
  mutate(Coherence = as.factor(Coherence))
```

```{r}
# 1. Calculate your slope means as before
slope_means_table <- d2 |> 
  group_by(Coherence, Condition) |> 
  summarise(
    Mean_Slope_Raw    = mean(Slope, na.rm = TRUE),
    Mean_Slope_Scaled = mean(Slope * 1e6, na.rm = TRUE),
    .groups = "drop"
  )

# 2. Merge them together by Coherence and Condition
cpp_vs_drift_df <- slope_means_table |> 
  left_join(drift_rates, by = c("Coherence", "Condition"))

# Print the final combined dataframe
print(cpp_vs_drift_df)
```

```{r}
# Quick correlation check: Do higher CPP slopes track higher drift rates?
cor.test(cpp_vs_drift_df$Mean_Slope_Raw,cpp_vs_drift_df$Drift_Rate)
```

```{r}
slope_ttest <- t.test(Mean_Slope_Raw ~ Condition, data = cpp_vs_drift_df)

# View the full output
print(slope_ttest)
```

