```{r}
d2 |>  
  # Crucial fix: Added 'group = interaction(Coherence, Condition)' 
  # This guarantees R calculates the dodge positions for text labels perfectly
  ggplot(aes(x = Coherence, y = Slope, fill = Condition, group = interaction(Coherence, Condition))) +
  
  geom_boxplot(
    position = position_dodge(width = 0.8),
    width = 0.6, 
    alpha = 0.8, 
    outlier.alpha = 0.4 
  ) +
  
  # Code to display mean values as numbers
  stat_summary(
    fun = mean,
    geom = "text",
    # Using %.2e ensures small slopes look like '2.34e-04' instead of '0.00'
    aes(label = sprintf("%.2e", after_stat(y))),  
    position = position_dodge(width = 0.8),       
    vjust = -0.7,                                 # Slightly pushed up away from overlapping lines
    size = 3.2,                                   # Made slightly smaller to fit the 6x12 grid cleanly
    fontface = "bold",
    show.legend = FALSE                           
  ) +
  
  # Colors
  scale_fill_manual(
    values = c("Control" = "blue", "BB" = "orange"),
    labels = c("Control" = "Control (Pink Noise)", "BB" = "Binaural Beats (20 Hz)")
  ) +
  
  geom_hline(yintercept = 0, linetype = "dashed", color = "gray50") +
  
  # Labels (Fixed: Removed duplicate y argument)
  labs(
    title = "CPP Build-up Rates (Pre-Response)",
    x = "Coherence Level (%)",
    y = expression("Slope " * (x10^-3)),
    fill = "Condition"
  ) +
  theme_classic() +
  theme(
    plot.title = element_text(hjust = 0.5, face = "bold", size = 14),
    plot.subtitle = element_text(hjust = 0.5, size = 10, face = "italic"),
    legend.position = "top"
  )

```

