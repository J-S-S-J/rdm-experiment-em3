```{r}
library(BayesFactor)

# 1. PREPARE THE DATA
# The BayesFactor package is very strict: your categorical variables 
# MUST be explicitly converted to factors, otherwise it will treat them as continuous math!
o1$Participant <- as.factor(o1$Participant)
o1$Condition   <- as.factor(o1$Condition)
o1$ROI         <- as.factor(o1$ROI)

# 2. RUN THE BAYESIAN ANOVA
# We test the main effects of Condition and ROI, plus their interaction (*),
# while explicitly declaring Participant as the random repeated measure.
bf_results <- anovaBF(
  formula = relative_power ~ ROI + Participant,
  data = o1,
  whichRandom = "Participant"
)

# 3. PRINT THE RESULTS
print(bf_results)
```

