glimpse(d1)
d2_frontal |>
ggplot(aes(x=Segment_ID, y=relative_power)) +
geom_point() +
geom_smooth(method = "lm") +
facet_wrap(~Condition)
d1 |>
ggplot(aes(x=Segment_ID, y=relative_power)) +
geom_point() +
geom_smooth(method = "lm") +
facet_grid(Condition ~ ROI)
d1 |>
ggplot(aes(x = Segment_ID, y = relative_power, color = Condition, fill = Condition)) +
# 1. The Points: Add transparency (alpha) so overlapping points look like a heat cluster
geom_point(alpha = 0.4, size = 1.5) +
# 2. The Line: Thicker line, subtle confidence interval ribbon
geom_smooth(method = "lm", linewidth = 1, alpha = 0.2) +
# 3. The Grid: Split by Condition (Rows) and ROI (Columns)
facet_grid(Condition ~ ROI) +
# 4. Consistent Colors: Map colors to match your previous ERP plots
scale_color_manual(values = c("Control" = "blue", "Binaural" = "orange")) +
scale_fill_manual(values = c("Control" = "blue", "Binaural" = "orange")) +
# 5. Professional Labels
labs(
title = "20 Hz RP over tid",
x = "Tidssegment",
y = "RP"
) +
# 6. A Clean Theme: theme_bw() puts a nice border around facet grids
theme_bw() +
theme(
# Center and bold the titles
plot.title = element_text(face = "bold", size = 14, hjust = 0.5),
plot.subtitle = element_text(size = 11, hjust = 0.5, face = "italic", color = "grey30"),
# Style the facet headers (the grey boxes at the top and side)
strip.background = element_rect(fill = "grey95", color = "black"),
strip.text = element_text(face = "bold", size = 11),
# Hide the legend! Since the rows are already labeled by Condition, a legend is redundant
legend.position = "none"
)
bf_full <- lmBF(
relative_power ~ Condition + Segment_ID + Subject,
data = d1,
whichRandom = "Subject"  # Tells R that 'Subject' is a random/repeated measure
)
